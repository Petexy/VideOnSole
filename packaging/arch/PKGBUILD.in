# Maintainer: Piotr Lewandowski <piotr.petexy@gmail.com>

pkgname=videonsole
pkgver=@VERSION@
pkgrel=1
pkgdesc='A film browser and player in the LineXinBar design language, shown as Videos'
arch=('x86_64' 'aarch64')
url='https://github.com/Petexy/videonsole'
license=('GPL-3.0-only')
# wayland and libxkbcommon are the window and the keyboard: the first is linked
# outright, the second is opened by name at run time and so is invisible to
# anything that reads the ELF. libglvnd is the EGL fallback wgpu takes on a
# machine with no Vulkan driver. udev is how the controllers are found.
#
# **ffmpeg is a runtime dependency here**, which is the one way this package
# differs from every other application built on this toolkit. They are pure
# Rust and link nothing; this one opens, demuxes and decodes films through
# libavcodec and its neighbours, and the finished binary really does carry
# NEEDED entries for them. A version bump of ffmpeg rebuilds this package.
#
# alsa-lib is the same kind of thing and is easy to miss: the sound library
# opens the machine's output through it, and `readelf -d` on the finished
# binary is where that shows.
depends=('glibc' 'gcc-libs' 'wayland' 'libxkbcommon' 'libglvnd' 'systemd-libs'
         'alsa-lib' 'ffmpeg')
# The toolkit is a *build* dependency and not a runtime one, which is the thing
# about this package that looks like a mistake and is not. `lxb-render` and its
# neighbours are Rust path dependencies: cargo compiles those sources into this
# binary, so what comes out links no liblxb_*.so at all and runs on a machine
# that has never heard of the toolkit. It is versioned all the same — this is
# built against one release of the language, not against whichever is lying
# about.
makedepends=('cargo' 'pkgconf' 'alsa-lib' 'ffmpeg' 'lxb-toolkit>=@TOOLKIT_VERSION@')
optdepends=('vulkan-icd-loader: draw through Vulkan rather than the EGL fallback'
            'pipewire-pulse: the interface sounds and the film soundtrack'
            'libva-mesa-driver: decode films on the graphics card rather than the processor'
            'intel-media-driver: the same, on Intel graphics'
            'xdg-desktop-portal: choose a folder through this desktop own chooser')
options=(!lto)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')
_videonsole_rustflags="${RUSTFLAGS:-}"

prepare() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    export RUSTFLAGS="$_videonsole_rustflags --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
    cargo build --frozen --release
}

check() {
    cd "$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    # `cargo test` already builds in the dev profile. Nothing here may pin an
    # optimisation level: RUSTFLAGS is appended after the profile's own flags
    # and wins.
    export RUSTFLAGS="$_videonsole_rustflags --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
    cargo test --frozen
}

package() {
    cd "$pkgname-$pkgver"
    ./packaging/install.sh \
        --destdir "$pkgdir" \
        --prefix /usr \
        --target-dir target

    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
